<view class="sheet-mask" wx:if="{{rendered}}" bindtap="onMask">
  <view
    class="sheet-panel"
    style="{{drag ? 'transform: translateY(' + drag + 'px);' : ''}}"
    catchtap="noop"
    catchtouchmove="noop"
    bindtouchstart="onStart"
    bindtouchmove="onMove"
    bindtouchend="onEnd"
  >
    <view class="sheet-handle"></view>
    <view class="sheet-title" wx:if="{{title}}">{{title}}</view>
    <view class="sheet-body" wx:if="{{content}}">{{content}}</view>
    <slot></slot>
    <button wx:if="{{confirmText}}" class="btn-primary sheet-confirm {{tone === 'danger' ? 'is-danger' : ''}}" hover-class="spring-in" bindtap="onConfirm">{{confirmText}}</button>
    <button class="sheet-dismiss" hover-class="spring-in" bindtap="onMask">{{dismissText}}</button>
  </view>
</view>
