.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(24, 38, 32, 0.46);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  transition: opacity 240ms ease;
}

.sheet-panel {
  width: 100%;
  max-width: 750rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 -10rpx 40rpx rgba(18, 38, 28, 0.12);
  transition: transform 280ms cubic-bezier(.34, 1.28, .4, 1);
}

.sheet-panel.is-dragging {
  transition: none;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #dbe4da;
  margin: 8rpx auto 24rpx;
}

/* 状态徽标 (例如退出登录 / 危险警示) */
.sheet-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin: 8rpx auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-badge.badge-danger {
  background: #fdf1f0;
  border: 2rpx solid #fad2cf;
  box-shadow: 0 4rpx 16rpx rgba(216, 69, 61, 0.12);
}

.sheet-badge.badge-danger .badge-symbol {
  font-size: 40rpx;
  font-weight: 700;
  color: #c4403a;
  line-height: 1;
}

.sheet-badge.badge-success {
  background: #edf7f1;
  border: 2rpx solid #cbe9d6;
}

.sheet-badge.badge-success .badge-symbol {
  font-size: 38rpx;
  font-weight: 700;
  color: #1b7a54;
  line-height: 1;
}

.sheet-badge.badge-primary {
  background: #edf5f2;
  border: 2rpx solid #d0e7dc;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 650;
  color: var(--text-main, #24342e);
  text-align: center;
  line-height: 1.35;
}

.sheet-body {
  margin-top: 14rpx;
  margin-bottom: 8rpx;
  color: var(--text-secondary, #56635c);
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
  padding: 0 12rpx;
}

/* 底部操作按钮组：并排双胶囊 */
.sheet-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 36rpx;
  width: 100%;
}

.sheet-btn {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  min-height: 92rpx;
  line-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 550;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
  border: 0;
  margin: 0;
  transition: transform 180ms cubic-bezier(.25, 1.4, .5, 1), background-color 120ms ease, box-shadow 120ms ease;
}

.sheet-btn::after {
  border: none;
}

/* 取消按钮 */
.sheet-btn-cancel,
.sheet-dismiss {
  background: #edf2ed;
  color: #4a5c50;
  border: 1rpx solid #dce5dc;
}

.sheet-btn-cancel:active,
.sheet-btn-cancel.spring-in,
.sheet-dismiss:active,
.sheet-dismiss.spring-in {
  background: #dfe7df;
  transform: scale(.975);
}

/* 确认按钮 */
.sheet-btn-confirm,
.sheet-confirm {
  background: var(--primary-color, #176b5d);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(23, 107, 93, 0.2);
}

.sheet-btn-confirm:active,
.sheet-btn-confirm.spring-in,
.sheet-confirm:active,
.sheet-confirm.spring-in {
  background: var(--primary-dark, #105246);
  transform: scale(.975);
  box-shadow: 0 2rpx 8rpx rgba(23, 107, 93, 0.12);
}

/* 危险操作确认按钮 (如退出登录、取消订单、拒绝接单) */
.sheet-btn-confirm.is-danger,
.sheet-confirm.is-danger {
  background: linear-gradient(135deg, #d9453d 0%, #be352e 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(217, 69, 61, 0.28);
}

.sheet-btn-confirm.is-danger:active,
.sheet-btn-confirm.is-danger.spring-in,
.sheet-confirm.is-danger:active,
.sheet-confirm.is-danger.spring-in {
  background: #a82e28;
  transform: scale(.975);
  box-shadow: 0 2rpx 8rpx rgba(217, 69, 61, 0.14);
}

.sheet-btn-confirm.is-success,
.sheet-confirm.is-success {
  background: #1f8a5b !important;
  color: #ffffff !important;
  box-shadow: 0 6rpx 18rpx rgba(31, 138, 91, 0.2);
}

/* 平板模式：从底部抽屉变为屏幕正中央典雅浮层卡片弹窗 */
@media (min-width: 600px) {
  .sheet-mask {
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .sheet-panel {
    max-width: 440px;
    width: 90%;
    padding: 32px 28px 28px;
    border-radius: 24px;
    box-shadow: 0 24px 64px rgba(24, 40, 32, 0.24);
  }
  .sheet-handle {
    display: none;
  }
  .sheet-badge {
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
  }
  .sheet-title {
    font-size: 20px;
  }
  .sheet-body {
    font-size: 16px;
    margin-top: 10px;
    margin-bottom: 24px;
  }
  .sheet-actions {
    margin-top: 24px;
    gap: 16px;
  }
  .sheet-btn {
    height: 48px;
    min-height: 48px;
    line-height: 48px;
    font-size: 16px;
    border-radius: 24px;
  }
}
