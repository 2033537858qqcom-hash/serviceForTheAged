.home-page { padding: 32rpx; padding-bottom: calc(var(--tab-bar-height) + 32rpx + env(safe-area-inset-bottom)); }
.home-header { position: sticky; top: 0; z-index: 4; display: flex; justify-content: space-between; gap: 20rpx; align-items: center; padding: 8rpx 2rpx 35rpx; transform-origin: left center; }
.home-brand { display: flex; align-items: center; gap: 15rpx; }
.home-brand-icon { width: 72rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx 22rpx 22rpx 5rpx; background: #e4edde; }
.home-brand-icon image { width: 46rpx; height: 46rpx; }
.brand-name { font-size: var(--font-title); color: var(--text-main); font-weight: 650; letter-spacing: 4rpx; line-height: 1.25; }
.brand-name text { color: #ad652f; }
.brand-community { color: var(--text-secondary); font-size: var(--font-meta); margin-top: 5rpx; }
.care-mode-control { display: flex; align-items: center; justify-content: center; gap: 9rpx; margin: 0; padding: 15rpx 20rpx; min-height: 76rpx; border-radius: 40rpx; background: #fff; border: 1rpx solid #e0e7da; color: var(--primary-color); font-size: var(--font-caption); white-space: nowrap; }
.care-mode-control image { width: 30rpx; height: 30rpx; }
.welcome-panel { position: relative; padding: 34rpx 34rpx 0; background: #e9efdf; border: 1rpx solid #dce5d3; border-radius: 28rpx; overflow: hidden; }
.welcome-panel::after { content: ''; width: 320rpx; height: 320rpx; border: 1rpx solid #cedbc0; border-radius: 50%; position: absolute; top: -160rpx; right: -170rpx; pointer-events: none; }
.welcome-kicker { color: #5f7351; font-size: var(--font-meta); letter-spacing: 2rpx; }
.welcome-title { font-size: 50rpx; font-weight: 600; line-height: 1.65; letter-spacing: 1rpx; color: #2e4c35; margin: 18rpx 0; }
.welcome-caption { font-size: var(--font-caption); color: #576b4c; margin-bottom: 30rpx; }
.welcome-contact { display: flex; align-items: center; min-height: 96rpx; border-top: 1rpx solid #d1ddc5; gap: 14rpx; color: #36553e; font-size: var(--font-caption); }
.welcome-contact image { width: 32rpx; height: 32rpx; }
.contact-hours { margin-left: auto; color: #617458; font-size: var(--font-meta); }
.welcome-contact .contact-arrow { width: 23rpx; height: 23rpx; }
.home-section-heading { display: flex; justify-content: space-between; align-items: center; gap: 15rpx; margin-top: 40rpx; }
.section-note { font-size: var(--font-meta); font-weight: 400; color: var(--text-secondary); white-space: nowrap; }
.service-stage { display: flex; align-items: stretch; gap: 16rpx; }
.service-entry-main { flex: 7; min-height: 360rpx; }
.service-stack { flex: 3; display: flex; flex-direction: column; gap: 12rpx; min-width: 0; }
.service-stack .service-entry { flex: 1; min-height: 0; padding: 16rpx; }
.service-stack .service-entry-icon { width: 52rpx; height: 52rpx; margin-bottom: 8rpx; border-radius: 14rpx; }
.service-stack .grid-name { font-size: var(--font-caption); }
.service-entry { position: relative; padding: 28rpx; border: 1rpx solid var(--border-color); border-radius: 22rpx; background: #fff; min-height: 236rpx; }
.service-entry-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; background: #eef3e8; border-radius: 20rpx; margin-bottom: 20rpx; }
.service-entry-icon image { height: 40rpx; width: 40rpx; }
.meal-icon { background: #f7efdf; }
.grid-name { color: var(--text-main); font-size: var(--font-section); font-weight: 600; }
.grid-desc { font-size: var(--font-caption); color: var(--text-secondary); margin-top: 5rpx; }
.staff-banner { margin-top: 28rpx; background: #eef4e9; }
.staff-banner > .flex-row { gap: 18rpx; }
.staff-title { font-size: var(--font-body); font-weight: 550; }
.staff-sub { color: var(--text-secondary); font-size: var(--font-meta); margin-top: 5rpx; }
.progress-overlap { position: relative; margin-bottom: 8rpx; }
.order-status-tag { position: absolute; top: 18rpx; right: 12rpx; z-index: 0; }
.active-order-card { position: relative; z-index: 1; margin-right: 36rpx; }
.service-name { font-size: var(--font-section); font-weight: 550; }
.active-order-meta { display: flex; align-items: flex-start; gap: 13rpx; font-size: var(--font-caption); color: var(--text-secondary); margin-top: 21rpx; }
.active-order-meta > image { width: 31rpx; height: 31rpx; flex-shrink: 0; margin-top: 5rpx; }
.order-footer { padding-top: 23rpx; margin-top: 25rpx; border-top: 1rpx solid var(--border-color); color: var(--primary-color); font-size: var(--font-caption); }
.more-link { display: flex; align-items: center; min-height: 64rpx; gap: 8rpx; font-size: var(--font-meta); font-weight: 400; color: var(--text-secondary); }
.more-link image { height: 23rpx; width: 23rpx; }
.home-service-card { display: flex; gap: 21rpx; align-items: center; padding: 27rpx; }
.service-list-icon { display: flex; align-items: center; justify-content: center; background: #f1f4e9; height: 90rpx; width: 86rpx; border-radius: 18rpx; flex-shrink: 0; }
.service-list-icon image { height: 46rpx; width: 46rpx; }
.service-main { flex: 1; min-width: 0; }
.item-title { font-size: var(--font-body); font-weight: 550; line-height: 1.5; }
.item-desc { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; font-size: var(--font-meta); color: var(--text-secondary); margin-top: 7rpx; }
.item-meta { margin-top: 12rpx; line-height: 1.5; }
.price { color: #ad652f; font-size: var(--font-section); font-weight: 600; }
.duration { color: var(--text-secondary); font-size: var(--font-meta); }
.home-footer { padding: 22rpx 0 10rpx; text-align: center; font-size: var(--font-meta); color: #6a7a63; letter-spacing: 2rpx; }
.service-empty { text-align: center; color: var(--text-secondary); font-size: var(--font-caption); padding: 45rpx 25rpx; }
.retry-button { margin-top: 20rpx; background: var(--primary-soft); color: var(--primary-color); font-size: var(--font-caption); width: fit-content; padding: 12rpx 30rpx; }
.elder-mode .service-stage, .elder-mode .service-stack { flex-direction: column; }
.elder-mode .service-entry-main, .elder-mode .service-stack { flex: none; width: 100%; }
.elder-mode .welcome-title { font-size: 58rpx; }
.elder-mode .home-header, .elder-mode .home-section-heading { flex-wrap: wrap; }
.elder-mode .section-note { display: none; }
.elder-mode .home-service-card { gap: 15rpx; }
.elder-mode .service-list-icon { display: none; }
.elder-mode .welcome-contact { flex-wrap: wrap; padding: 18rpx 0; }
.elder-mode .contact-hours { margin-left: 0; }