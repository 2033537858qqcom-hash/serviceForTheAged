.home-page { padding: 32rpx; padding-bottom: calc(var(--tab-bar-height) + 32rpx + env(safe-area-inset-bottom)); }
.home-header { display: flex; justify-content: space-between; gap: 20rpx; align-items: center; padding: 0 0 28rpx; }
.home-brand { display: flex; flex: 1; min-width: 0; align-items: center; gap: 16rpx; }
.home-brand-copy { min-width: 0; }
.home-brand-icon {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: block;
}
.home-brand-icon image {
  width: 100%;
  height: 100%;
  display: block;
}
.brand-name { font-size: var(--font-title); color: var(--text-main); font-weight: 650; letter-spacing: 4rpx; line-height: 1.25; }
.brand-name text { color: var(--price-color); }
.brand-community { color: var(--text-secondary); font-size: var(--font-meta); margin-top: 5rpx; white-space: nowrap; }
.care-mode-control { display: flex; flex: 0 0 188rpx; width: 188rpx; align-items: center; justify-content: center; gap: 9rpx; margin: 0; padding: 12rpx 24rpx; min-height: 88rpx; line-height: 1.3; border-radius: 44rpx; background: #fff; border: 1rpx solid #e0e7da; color: var(--primary-color); font-size: var(--font-caption); white-space: nowrap; transition: transform 200ms var(--motion-ease), background-color 120ms ease; }
.care-mode-control image { flex-shrink: 0; width: 30rpx; height: 30rpx; }
.care-mode-control.care-mode-pressed { transform: scale(.96); background: var(--primary-soft); }

/* 进行中的服务（置顶卡片） */
.active-order-card { position: relative; margin-top: 8rpx; margin-bottom: 30rpx; border: 2rpx solid #b8ded0; box-shadow: 0 6rpx 18rpx rgba(23,107,93,.06); }
.service-name { font-size: var(--font-section); font-weight: 600; color: var(--text-main); }
.active-order-badge { font-size: var(--font-meta); color: var(--primary-color); background: var(--primary-soft); padding: 6rpx 16rpx; border-radius: 10rpx; font-weight: 600; }
.active-order-meta { display: flex; align-items: flex-start; gap: 14rpx; font-size: var(--font-caption); color: var(--text-secondary); margin-top: 18rpx; }
.active-order-meta > image { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-top: 4rpx; }
.order-footer { padding-top: 22rpx; margin-top: 24rpx; border-top: 1rpx solid var(--border-color); color: var(--primary-color); font-size: var(--font-caption); }
.order-footer-text { font-weight: 550; }

/* 欢迎面板 */
.welcome-panel { position: relative; padding: 34rpx 34rpx 0; background: #e9efdf; border: 1rpx solid #dce5d3; border-radius: 28rpx; overflow: hidden; margin-bottom: 24rpx; }
.welcome-panel::after { content: ''; width: 320rpx; height: 320rpx; border: 1rpx solid #cedbc0; border-radius: 50%; position: absolute; top: -160rpx; right: -170rpx; pointer-events: none; }
.welcome-kicker { color: #5f7351; font-size: var(--font-meta); letter-spacing: 2rpx; }
.welcome-title { font-size: 50rpx; font-weight: 600; line-height: 1.65; letter-spacing: 1rpx; color: #2e4c35; margin: 18rpx 0; }
.welcome-caption { font-size: var(--font-caption); color: #576b4c; margin-bottom: 30rpx; }
.welcome-contact { display: flex; align-items: center; min-height: 96rpx; border-top: 1rpx solid #d1ddc5; gap: 14rpx; color: #36553e; font-size: var(--font-caption); }
.welcome-contact image { width: 32rpx; height: 32rpx; }
.contact-hours { margin-left: auto; color: #617458; font-size: var(--font-meta); }
.welcome-contact .contact-arrow { width: 23rpx; height: 23rpx; }

.home-section-heading { display: flex; justify-content: space-between; align-items: center; gap: 15rpx; margin-top: 36rpx; }
.section-note { font-size: var(--font-meta); font-weight: 400; color: var(--text-secondary); white-space: nowrap; }

/* 2x2 平衡四宫格服务入口 */
.service-grid-2x2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; margin-top: 10rpx; }
.service-entry-card { display: flex; flex-direction: column; justify-content: space-between; padding: 0; overflow: hidden; background: #fff; border: 1rpx solid var(--border-color); border-radius: 22rpx; min-height: 200rpx; }
.service-entry-photo { height: 176rpx; width: 100%; flex-shrink: 0; background: #eaf0e3; overflow: hidden; display: block; }
.service-entry-photo service-photo,
.service-entry-photo .service-photo,
.service-entry-photo image {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}
.service-entry-card .service-card-info { padding: 20rpx 22rpx 24rpx; }
.service-card-info .grid-name { font-size: var(--font-section); font-weight: 600; color: var(--text-main); line-height: 1.35; }
.service-card-info .grid-desc { font-size: var(--font-caption); color: var(--text-secondary); margin-top: 6rpx; line-height: 1.3; }

.staff-banner { margin-top: 28rpx; background: #eef4e9; }
.staff-banner > .flex-row { gap: 18rpx; }
.staff-title { font-size: var(--font-body); font-weight: 550; }
.staff-sub { color: var(--text-secondary); font-size: var(--font-meta); margin-top: 5rpx; }

.more-link { display: flex; align-items: center; min-height: 88rpx; padding-left: 16rpx; gap: 8rpx; font-size: var(--font-meta); font-weight: 400; color: var(--text-secondary); }
.more-link image { height: 23rpx; width: 23rpx; }
.home-service-card { display: flex; gap: 21rpx; align-items: center; padding: 27rpx; }
.service-list-icon {
  width: 136rpx;
  height: 116rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #eaf0e3;
  flex-shrink: 0;
  display: block;
}
.service-list-icon service-photo,
.service-list-icon .service-photo,
.service-list-icon image {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.service-main { flex: 1; min-width: 0; }
.item-title { font-size: var(--font-body); font-weight: 550; line-height: 1.5; }
.item-desc { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; font-size: var(--font-meta); color: var(--text-secondary); margin-top: 7rpx; }
.item-meta { margin-top: 12rpx; line-height: 1.5; }
.price { color: var(--price-color); font-size: var(--font-section); font-weight: 600; }
.duration { color: var(--text-secondary); font-size: var(--font-meta); }
.home-footer { padding: 26rpx 0 16rpx; text-align: center; font-size: var(--font-meta); color: #6a7a63; letter-spacing: 2rpx; }
.service-empty { text-align: center; color: var(--text-secondary); font-size: var(--font-caption); padding: 45rpx 25rpx; }
.retry-button { margin-top: 20rpx; background: var(--primary-soft); color: var(--primary-color); font-size: var(--font-caption); width: fit-content; padding: 12rpx 30rpx; }

/* 适老化大字模式样式覆盖 */
.elder-mode .service-grid-2x2 { grid-template-columns: 1fr; gap: 18rpx; }
.elder-mode .service-entry-card { flex-direction: row; align-items: center; justify-content: flex-start; gap: 24rpx; min-height: 140rpx; }
.elder-mode .service-entry-photo { width: 220rpx; height: 200rpx; border-radius: 16rpx; flex-shrink: 0; }
.elder-mode .service-entry-card .service-card-info { flex: 1; min-width: 0; padding: 24rpx 20rpx 24rpx 0; }
.elder-mode .welcome-title { font-size: 58rpx; }
.elder-mode .home-section-heading { flex-wrap: wrap; }
.elder-mode .care-mode-control { flex-basis: 210rpx; width: 210rpx; min-height: 96rpx; }
.elder-mode .section-note { display: none; }
.elder-mode .home-service-card { gap: 15rpx; }
.elder-mode .service-list-icon { display: block; width: 156rpx; height: 132rpx; }
.elder-mode .welcome-contact { flex-wrap: wrap; padding: 18rpx 0; }
.elder-mode .contact-hours { margin-left: 0; }
.elder-mode .home-brand-icon { width: 88rpx; height: 88rpx; border-radius: 22rpx; }

.home-skeleton-card { padding: 32rpx; margin-bottom: 24rpx; }

/* 进行中订单主卡片 + 一键进度 */
.active-order-hero { padding: 32rpx; margin-bottom: 8rpx; border-color: #d4e4d9; background: #f3f8f2; }
.active-order-cta {
  width: 100%;
  margin-top: 28rpx;
  min-height: 96rpx;
  border-radius: var(--radius-md, 20rpx);
}
.elder-mode .active-order-cta { min-height: var(--control-height); }
.compact-heading { margin-top: 28rpx; margin-bottom: 12rpx; }
.service-strip {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.service-strip-item {
  flex: 1;
  min-width: 0;
  min-height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 8rpx;
  background: #fff;
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg, 24rpx);
}
.service-strip-photo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  overflow: hidden;
}
.service-strip-label {
  font-size: var(--font-caption);
  color: var(--text-main);
  font-weight: 550;
}
