.container {
  padding: 24rpx;
}

.header-card {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #ffffff;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.community-title {
  font-size: 38rpx;
  font-weight: bold;
}

.welcome-text {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.mode-switch-box {
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 40rpx;
}

.mode-text {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.emergency-bar {
  background: #fff1f0;
  border: 2rpx solid #ffa39e;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

.emergency-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.emergency-label {
  color: #cf1322;
  font-weight: bold;
  font-size: 28rpx;
}

.emergency-btn {
  background: #ff4d4f;
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin: 20rpx 0 16rpx 0;
  color: #262626;
}

.more-link {
  font-size: 26rpx;
  color: #8c8c8c;
  font-weight: normal;
}

.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.grid-item {
  background: #ffffff;
  padding: 28rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.grid-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}

.bg-meal { background: #fff7e6; }
.bg-cleaning { background: #e6f7ff; }
.bg-errand { background: #f6ffed; }
.bg-escort { background: #f9f0ff; }

.grid-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
}

.grid-desc {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
}

.staff-banner {
  background: #f0f5ff;
  border: 1rpx solid #adc6ff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.staff-badge {
  width: 60rpx;
  height: 60rpx;
  background: #2f54eb;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.staff-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1d39c4;
}

.staff-sub {
  font-size: 24rpx;
  color: #597ef7;
}

.arrow {
  color: #2f54eb;
  font-weight: bold;
  font-size: 28rpx;
}

.active-order-card {
  border-left: 8rpx solid #1890ff;
}

.order-header {
  margin-bottom: 12rpx;
}

.service-name {
  font-size: 32rpx;
  font-weight: bold;
}

.order-info-line {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 8rpx;
}

.order-footer {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.staff-info {
  font-size: 24rpx;
  color: #1890ff;
}

.detail-link {
  font-size: 24rpx;
  color: #8c8c8c;
}

.service-card {
  margin-bottom: 20rpx;
}

.service-main {
  flex: 1;
  margin-right: 20rpx;
}

.item-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
}

.item-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  margin: 8rpx 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  margin-top: 8rpx;
}

.price {
  font-size: 34rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.duration {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-left: 8rpx;
}

.area-tag {
  font-size: 20rpx;
  background: #f5f5f5;
  color: #595959;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 14rpx;
}

.btn-book {
  padding: 0 28rpx !important;
  height: 64rpx;
  line-height: 64rpx;
}
