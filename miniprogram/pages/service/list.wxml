<view class="service-page {{isElderMode ? 'elder-mode' : ''}}">
  <view class="listing-header-area">
    <view class="listing-header">
      <view class="listing-title">家门口的贴心服务</view>
      <view class="listing-caption">按您的需要，左右滑动挑选最合适的居家照护。</view>
    </view>

    <!-- 平滑滑动分类选项栏 -->
    <scroll-view class="category-scroll" scroll-x="true" scroll-with-animation="true" scroll-into-view="cat-nav-{{currentCatIndex}}">
      <view class="category-bar">
        <view
          wx:for="{{categories}}"
          wx:key="key"
          id="cat-nav-{{index}}"
          class="cat-nav-item {{currentCatIndex === index ? 'active' : ''}}"
          bindtap="changeCat"
          data-index="{{index}}"
        >
          <text class="cat-label">{{item.label}}</text>
        </view>
        <!-- 平滑滑动下划指示条 -->
        <view
          class="cat-slider {{sliderLive ? 'is-live' : ''}}"
          style="transform: translateX({{sliderShift}}%);"
        ><view class="slider-line"></view></view>
      </view>
    </scroll-view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading && !loaded}}" class="empty-tip">
    正在加载社区服务…
  </view>
  <view wx:elif="{{loadError && !loaded}}" class="empty-tip">
    服务暂时未能加载
    <button class="retry-button" bindtap="loadServices">重新加载</button>
  </view>

  <!-- 滑动内容区域 (Swiper 支持平滑左右手势滑动) -->
  <swiper
    wx:else
    class="service-swiper"
    current="{{currentCatIndex}}"
    duration="220"
    bindtouchstart="onSwiperTouchStart"
    bindtransition="onSwiperTransition"
    bindchange="onSwiperChange"
    bindanimationfinish="onAnimationFinish"
  >
    <swiper-item wx:for="{{categories}}" wx:key="key" class="swiper-page-item">
      <scroll-view wx:if="{{visibleTabs[index]}}" class="service-scroll" scroll-y="true">
        <view class="service-list-content">
          <view
            class="card service-card spring"
            wx:for="{{catServices[index]}}"
            wx:key="id"
            hover-class="card-pressed"
            hover-start-time="0"
            hover-stay-time="60"
            bindtap="goToDetail"
            data-id="{{item.id}}"
          >
            <view class="service-card-main">
              <view class="service-picture">
                <service-photo src="{{item.imageUrl}}" fallback="{{item.imageFallback}}" />
              </view>
              <view class="service-copy">
                <view class="item-name">{{item.name}}</view>
                <view class="item-desc">{{item.description}}</view>
                <view class="service-meta">
                  <text>{{item.durationMinutes}}分钟</text>
                  <text> · </text>
                  <text>{{item.serviceArea}}</text>
                </view>
              </view>
            </view>
            <view class="item-footer">
              <view>
                <text class="item-price">¥{{item.price}}</text>
                <text class="price-unit"> / 次</text>
              </view>
              <button class="btn-primary book-button" hover-class="button-pressed" catchtap="quickBook" data-id="{{item.id}}">
                预约服务
                <image src="/assets/icons/arrow.png" />
              </button>
            </view>
          </view>

          <!-- 分类为空的提示 -->
          <view class="empty-tip" wx:if="{{catServices[index].length === 0}}">
            <view class="empty-text">暂无该分类的服务，可左右滑动看看其他项目。</view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
