.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.main-info-card {
  padding: 36rpx 28rpx;
}

.service-title {
  font-size: 40rpx;
  font-weight: bold;
}

.service-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin: 16rpx 0;
}

.unit {
  font-size: 26rpx;
  color: #8c8c8c;
  font-weight: normal;
}

.tags-row {
  margin-top: 16rpx;
}

.detail-section {
  padding: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  border-left: 8rpx solid #1890ff;
  padding-left: 16rpx;
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 28rpx;
  color: #595959;
  line-height: 1.7;
}

.tips-item {
  font-size: 26rpx;
  color: #595959;
  line-height: 1.8;
  margin-bottom: 8rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 99;
}

.price-label {
  font-size: 26rpx;
  color: #8c8c8c;
}

.total-price {
  font-size: 44rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.btn-submit {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  margin: 0;
  font-size: 32rpx;
}
