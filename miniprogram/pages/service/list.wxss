.container {
  padding: 20rpx;
}

.category-scroll {
  white-space: nowrap;
  background: #ffffff;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #595959;
}

.cat-item.active {
  background: #1890ff;
  color: #ffffff;
  font-weight: 500;
}

.service-card {
  margin-bottom: 24rpx;
}

.item-name {
  font-size: 34rpx;
  font-weight: bold;
}

.item-price {
  font-size: 38rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.item-desc {
  font-size: 26rpx;
  color: #595959;
  margin: 16rpx 0;
  line-height: 1.5;
}

.item-footer {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.empty-tip {
  text-align: center;
  color: #bfbfbf;
  margin-top: 100rpx;
  font-size: 28rpx;
}
