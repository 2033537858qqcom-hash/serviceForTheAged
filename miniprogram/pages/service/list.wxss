page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F7F3;
}

.service-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom));
}

.listing-header-area {
  flex-shrink: 0;
  padding: 16rpx 32rpx 0;
  background: #F6F7F3;
  z-index: 10;
}

.listing-header {
  padding: 8rpx 0 16rpx;
}

.listing-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.listing-caption {
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

/* 分类滑动条 */
.category-scroll {
  white-space: nowrap;
  width: 100%;
  border-bottom: 2rpx solid #e0e5de;
}

.category-bar {
  display: inline-flex;
  position: relative;
  min-width: 100%;
  padding-bottom: 6rpx;
}

.cat-nav-item {
  flex: 0 0 var(--swipe-tab-width);
  width: var(--swipe-tab-width);
  text-align: center;
  padding: 20rpx 10rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: color 0.25s ease;
}

.cat-nav-item.active {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 平滑滑动指示条 */
.cat-slider {
  position: absolute;
  bottom: 0;
  left: 0;
  width: var(--swipe-tab-width);
  height: 6rpx;
  transition: transform var(--motion-standard) var(--motion-ease);
}
.cat-slider.is-live { transition: none; }
.slider-line { width: 44rpx; height: 6rpx; margin: 0 auto; background: var(--primary-color); border-radius: 4rpx; }

/* Swiper 滑动区域 */
.service-swiper {
  flex: 1;
  height: 100%;
  min-height: 400rpx;
  width: 100%;
}

.swiper-page-item {
  height: 100%;
}

.service-scroll {
  height: 100%;
  box-sizing: border-box;
}

.service-list-content {
  padding: 24rpx 32rpx 32rpx;
}

.service-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: none;
}

.service-card-main {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.service-picture {
  flex-shrink: 0;
  display: block;
  width: 156rpx;
  height: 132rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef3e7;
  position: relative;
}

.service-picture service-photo,
.service-picture .service-photo,
.service-picture image {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

.service-copy {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: var(--font-section);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-main);
}

.item-desc {
  color: var(--text-secondary);
  font-size: var(--font-caption);
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.service-meta {
  margin-top: 14rpx;
  font-size: var(--font-meta);
  color: #5b7250;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border-color);
}

.item-price {
  font-size: var(--font-display);
  font-weight: 600;
  color: #ad652f;
}

.price-unit {
  color: var(--text-secondary);
  font-size: var(--font-meta);
}

.book-button {
  margin: 0;
  min-height: 80rpx;
  padding: 16rpx 28rpx;
  font-size: var(--font-caption);
  gap: 10rpx;
  display: inline-flex;
  align-items: center;
  transition: opacity var(--motion-fast);
}

.book-button image {
  width: 22rpx;
  height: 22rpx;
  filter: brightness(0) invert(1);
}

.empty-tip {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-text {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.retry-button {
  margin: 24rpx auto 0;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: var(--font-body);
  min-height: var(--control-height);
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 14rpx;
}

/* 适老模式适配 */
.elder-mode .service-card-main {
  flex-direction: column;
}

.elder-mode .service-picture {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.elder-mode .item-footer {
  flex-wrap: wrap;
}
