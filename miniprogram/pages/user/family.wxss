.container {
  padding: 24rpx;
}

.apply-card {
  padding: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  border-left: 8rpx solid #1890ff;
  padding-left: 14rpx;
  margin-bottom: 12rpx;
}

.form-tip {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.label {
  font-size: 26rpx;
  color: #595959;
  display: block;
  margin-bottom: 10rpx;
}

.picker-box, .input-box {
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #bfbfbf;
}

.btn-apply {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  border-radius: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 32rpx 0 16rpx 0;
}

.binding-item {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.elder-title {
  font-size: 32rpx;
  font-weight: bold;
}

.bind-meta {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
}

.revoke-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  text-align: right;
  margin-top: 12rpx;
}

.empty-tip {
  text-align: center;
  color: #bfbfbf;
  margin-top: 60rpx;
  font-size: 28rpx;
}
