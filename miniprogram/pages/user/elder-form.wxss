.card-title { font-size: var(--font-section); font-weight: 600; margin-bottom: 12rpx; }
.form-item { display: flex; flex-direction: column; align-items: stretch; gap: 14rpx; padding: 24rpx 0; }
.label-row { width: 100%; display: flex; justify-content: space-between; align-items: center; }
.label { font-size: var(--font-caption); color: var(--text-regular); }
.map-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: rgba(23, 107, 93, 0.08);
  border: 1rpx solid rgba(23, 107, 93, 0.25);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
  cursor: pointer;
  transition: transform 0.15s ease, background-color 0.15s ease;
}
.map-picker-btn:active {
  transform: scale(0.96);
  background: rgba(23, 107, 93, 0.16);
}
.coord-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--primary-color);
  background: rgba(23, 107, 93, 0.05);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}
.badge-icon { font-weight: bold; }
.input, .picker-val { width: 100%; min-height: var(--control-height); height: var(--control-height); border: 1rpx solid var(--border-color); border-radius: 14rpx; background: #f7f9f5; font-size: var(--font-body); padding: 22rpx; }
.picker-val { display: flex; align-items: center; justify-content: space-between; }
.btn-save { margin-top: 30rpx; }
