.elder-list-page { padding: 32rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.page-header { margin-bottom: 28rpx; }
.page-title { font-size: var(--font-title); font-weight: 650; color: var(--text-main); line-height: 1.3; }
.page-desc { font-size: var(--font-caption); color: var(--text-secondary); margin-top: 8rpx; }

.skeleton-card { padding: 32rpx; margin-bottom: 24rpx; }

.empty-state-card { text-align: center; padding: 70rpx 40rpx; margin-top: 40rpx; }
.empty-icon { width: 100rpx; height: 100rpx; opacity: 0.35; margin-bottom: 24rpx; }
.empty-title { font-size: var(--font-section); font-weight: 600; color: var(--text-main); margin-bottom: 12rpx; }
.empty-sub { font-size: var(--font-caption); color: var(--text-secondary); line-height: 1.6; margin-bottom: 36rpx; }
.btn-add-empty { width: 80%; margin: 0 auto; }

.elder-card { padding: 30rpx; margin-bottom: 24rpx; border: 1rpx solid var(--border-color); }
.card-top { border-bottom: 1rpx solid #edf2ec; padding-bottom: 18rpx; margin-bottom: 20rpx; }
.elder-identity { gap: 14rpx; align-items: baseline; }
.elder-name { font-size: var(--font-section); font-weight: 650; color: var(--text-main); }
.gender-tag { padding: 4rpx 12rpx; font-size: var(--font-meta); }
.elder-age { font-size: var(--font-caption); color: var(--text-secondary); font-weight: 500; }
.care-tag { font-weight: 550; }

.elder-detail-item { gap: 14rpx; margin-top: 14rpx; align-items: flex-start; }
.elder-detail-item > image { margin-top: 6rpx; flex-shrink: 0; }
.detail-text { font-size: var(--font-caption); color: var(--text-regular); line-height: 1.5; flex: 1; }
.note-text { color: #6a7c6e; }

.card-actions { border-top: 1rpx solid #edf2ec; margin-top: 24rpx; padding-top: 20rpx; }
.community-name { font-size: var(--font-meta); color: var(--text-secondary); }
.btn-edit-card { height: 56rpx; min-height: 56rpx; line-height: 54rpx; padding: 0 24rpx; font-size: 25rpx; font-weight: 500; border-radius: 12rpx; border: 1rpx solid #c4ded2; background: #edf5f1; color: var(--primary-color); box-sizing: border-box; }
.btn-edit-card::after { border: none; }

.bottom-action-box { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1rpx solid var(--border-color); padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -4rpx 14rpx rgba(0,0,0,.03); z-index: 10; }
.btn-add-bottom { width: 100%; }

.elder-mode .page-title { font-size: 50rpx; }
.elder-mode .elder-name { font-size: 42rpx; }
.elder-mode .btn-edit-card { height: 76rpx; min-height: 76rpx; line-height: 74rpx; padding: 0 32rpx; font-size: var(--font-body); border-radius: 14rpx; }
