.container {
  padding: 24rpx;
}

.user-card {
  padding: 36rpx 28rpx;
  background: #ffffff;
}

.avatar {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
}

.user-sub {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
}

.role-tag {
  margin-top: 10rpx;
}

.btn-logout {
  background: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffa39e;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.mock-login-card {
  padding: 28rpx;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
}

.mock-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #389e0d;
  margin-bottom: 20rpx;
}

.mock-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.btn-mock {
  background: #ffffff;
  color: #237804;
  border: 1rpx solid #b7eb8f;
  font-size: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  margin: 0;
  padding: 0 10rpx;
}

.menu-card {
  padding: 10rpx 24rpx;
  margin-top: 24rpx;
}

.menu-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #262626;
}

.arrow {
  font-size: 36rpx;
  color: #bfbfbf;
}
