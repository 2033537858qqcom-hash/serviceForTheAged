.container {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.staff-header-card {
  padding: 28rpx;
  background: #ffffff;
}

.staff-avatar {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.staff-name {
  font-size: 34rpx;
  font-weight: bold;
}

.staff-meta {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
}

.status-pill {
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.pill-online {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}

.pill-offline {
  background: #f5f5f5;
  color: #8c8c8c;
  border: 1rpx solid #d9d9d9;
}

.alert-title {
  color: #fa8c16;
  font-weight: bold;
  font-size: 32rpx;
}

.countdown-badge {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #fff1f0;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.pending-card {
  border: 2rpx solid #ffa940;
  background: #fffbe6;
  padding: 28rpx;
}

.pending-service-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #d46b08;
}

.pending-line {
  font-size: 26rpx;
  color: #595959;
  margin-top: 10rpx;
}

.pending-actions {
  margin-top: 24rpx;
  gap: 20rpx;
}

.btn-reject {
  flex: 1;
  background: #ffffff;
  color: #ff4d4f;
  border: 1rpx solid #ffa39e;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-accept {
  flex: 2;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 32rpx 0 16rpx 0;
  color: #262626;
}

.task-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.task-name {
  font-size: 32rpx;
  font-weight: bold;
}

.task-line {
  font-size: 26rpx;
  color: #595959;
  margin-top: 10rpx;
}

.task-actions {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-call {
  background: #f5f5f5;
  color: #595959;
}

.completed-hint {
  font-size: 24rpx;
  color: #52c41a;
}

.empty-tip {
  text-align: center;
  color: #bfbfbf;
  margin-top: 80rpx;
  font-size: 28rpx;
}

/* 模态弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-box {
  width: 640rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
}

.modal-tip {
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
  margin: 10rpx 0 24rpx 0;
}

.modal-textarea {
  width: 100%;
  height: 200rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.modal-btns {
  margin-top: 28rpx;
  gap: 20rpx;
}

.modal-btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #595959;
  font-size: 28rpx;
}

.modal-btn-submit {
  flex: 1;
  font-size: 28rpx;
}
