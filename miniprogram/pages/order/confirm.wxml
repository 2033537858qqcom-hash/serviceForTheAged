<view class="container scroll-content-with-bottom {{isElderMode ? 'elder-mode' : ''}}">
  <view class="card review-context" wx:if="{{reviewContext}}">
    <view class="review-context-title">您正在评价：{{reviewContext.service}}</view>
    <view class="review-context-meta" wx:if="{{reviewContext.staff}}">服务人员：{{reviewContext.staff}}</view>
    <view class="review-context-meta" wx:if="{{reviewContext.doneText}}">完成时间：{{reviewContext.doneText}}</view>
  </view>
  <view class="card rating-card">
    <view class="rating-title">服务满意度评分</view>
    <view class="stars-box flex-row">
      <view class="star-item {{rating >= item ? 'active' : ''}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this" bindtap="setRating" data-rating="{{item}}">
        ★
      </view>
    </view>
    <view class="score-desc">{{scoreDescMap[rating] || '请点击星星打分'}}</view>
  </view>

  <view class="card comment-card">
    <view class="rating-title">评语或建议</view>
    <textarea class="comment-input" placeholder="请记录您对服务态度、准时程度、操作规范等方面的意见..." value="{{content}}" bindinput="onInputContent" maxlength="200" cursor-spacing="140" />
  </view>

  <!-- 底部固定吸底操作栏 -->
  <view class="confirm-bottom-bar safe-bottom">
    <button class="btn-primary btn-submit {{isElderMode ? 'btn-large' : ''}} {{submitSuccess ? 'is-success' : ''}}" loading="{{submitting}}" disabled="{{submitting || submitSuccess}}" bindtap="submitReview">
      <text wx:if="{{submitSuccess}}">✓ 评价已完成</text>
      <text wx:elif="{{submitting}}">正在提交评价…</text>
      <text wx:else>提交评价</text>
    </button>
  </view>
</view>
