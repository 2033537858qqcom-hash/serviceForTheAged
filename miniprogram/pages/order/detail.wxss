.container {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.status-banner {
  color: #ffffff;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.bg-WAIT_DISPATCH, .bg-WAIT_ACCEPT, .bg-WAIT_MANUAL {
  background: linear-gradient(135deg, #faad14, #ffc53d);
}

.bg-WAIT_VISIT, .bg-IN_SERVICE {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
}

.bg-WAIT_CONFIRM {
  background: linear-gradient(135deg, #fa8c16, #ffa940);
}

.bg-COMPLETED {
  background: linear-gradient(135deg, #52c41a, #73d13d);
}

.bg-CANCELLED {
  background: linear-gradient(135deg, #8c8c8c, #bfbfbf);
}

.status-title {
  font-size: 40rpx;
  font-weight: bold;
}

.status-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.staff-card {
  padding: 24rpx 28rpx;
}

.staff-avatar {
  font-size: 60rpx;
  margin-right: 20rpx;
}

.staff-name {
  font-size: 32rpx;
  font-weight: bold;
}

.staff-sub {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 6rpx;
}

.btn-dial {
  background: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.info-card {
  padding: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  border-left: 8rpx solid #1890ff;
  padding-left: 14rpx;
  margin-bottom: 24rpx;
}

.info-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #fafafa;
}

.label {
  font-size: 26rpx;
  color: #8c8c8c;
}

.value {
  font-size: 28rpx;
  color: #262626;
  max-width: 460rpx;
  text-align: right;
}

.value.bold { font-weight: bold; }
.value.price { color: #ff4d4f; font-weight: bold; }
.value.code { font-family: monospace; font-size: 24rpx; }

.record-card, .review-card, .timeline-card {
  padding: 28rpx;
}

.record-line {
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 12rpx;
}

.record-summary {
  font-size: 28rpx;
  color: #262626;
  background: #fafafa;
  padding: 16rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.rating-stars {
  font-size: 30rpx;
  color: #faad14;
  font-weight: bold;
}

.review-content {
  font-size: 28rpx;
  color: #595959;
  line-height: 1.6;
}

.timeline {
  padding-left: 20rpx;
  border-left: 2rpx solid #e8e8e8;
  margin-left: 10rpx;
}

.timeline-node {
  position: relative;
  margin-bottom: 24rpx;
}

.dot {
  position: absolute;
  left: -27rpx;
  top: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1890ff;
}

.node-time {
  font-size: 22rpx;
  color: #bfbfbf;
}

.node-text {
  font-size: 26rpx;
  color: #595959;
  margin-top: 4rpx;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  z-index: 99;
  gap: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #f5f5f5;
  color: #595959;
  font-size: 30rpx;
  border-radius: 40rpx;
}

.btn-confirm, .btn-review {
  flex: 2;
  font-size: 30rpx;
  border-radius: 40rpx;
}
