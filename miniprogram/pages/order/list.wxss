page {
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  background: #F6F7F3;
}

.page-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom));
}

.order-header-area {
  flex-shrink: 0;
  padding: 16rpx 32rpx 0;
  background: #F6F7F3;
  z-index: 10;
}

.page-intro {
  margin-bottom: 16rpx;
}

.page-title {
  font-size: var(--font-title);
  font-weight: 600;
  color: var(--text-main);
}

.page-subtitle {
  color: var(--text-secondary);
  font-size: var(--font-caption);
  margin-top: 6rpx;
}

/* 滑动选项卡栏 */
.tabs-scroll {
  white-space: nowrap;
  width: 100%;
  border-bottom: 2rpx solid #e0e5de;
}

.tabs-bar {
  display: inline-flex;
  position: relative;
  min-width: 100%;
  padding-bottom: 6rpx;
}

.tab-nav-item {
  flex: 0 0 var(--swipe-tab-width);
  width: var(--swipe-tab-width);
  text-align: center;
  padding: 20rpx 8rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
  transition: color 0.25s ease;
}

.tab-nav-item.active {
  color: var(--primary-dark);
  font-weight: 600;
}

/* 平滑滑动指示条 */
.tab-slider {
  position: absolute;
  bottom: 0;
  left: 0;
  width: var(--swipe-tab-width);
  height: 6rpx;
  transition: transform var(--motion-standard) var(--motion-ease);
}
.tab-slider.is-live { transition: none; }
.slider-line { width: 44rpx; height: 6rpx; margin: 0 auto; background: var(--primary-color); border-radius: 4rpx; }


/* Swiper 滑动区域 */
.order-swiper {
  flex: 1;
  height: 100%;
  min-height: 400rpx;
  width: 100%;
}

.swiper-page-item {
  height: 100%;
}

.order-scroll {
  height: 100%;
  box-sizing: border-box;
}

.order-list-content {
  padding: 24rpx 32rpx 32rpx;
}

.card-top {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid var(--border-color);
  align-items: flex-start;
}

.order-no {
  font-size: var(--font-meta);
  color: var(--text-secondary);
  overflow-wrap: anywhere;
}

.service-name-row {
  margin: 26rpx 0 22rpx;
  align-items: flex-start;
}

.service-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--text-main);
}

.service-price {
  font-size: var(--font-section);
  color: var(--primary-dark);
  font-weight: 600;
  white-space: nowrap;
}

.order-row {
  font-size: var(--font-caption);
  color: var(--text-regular);
  margin-top: 12rpx;
}

.card-bottom {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--border-color);
}

.staff-hint {
  flex: 1;
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.btn-action {
  margin: 0;
  min-height: 78rpx;
  font-size: var(--font-caption);
  padding: 14rpx 24rpx;
  flex-shrink: 0;
}

.empty-tip {
  padding: 100rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 88rpx;
  height: 88rpx;
  display: block;
  margin: 0 auto 24rpx;
  opacity: .6;
}

.empty-text {
  font-size: var(--font-caption);
  color: var(--text-secondary);
}

.loading-more, .no-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 32rpx 0;
}

/* 大字适老化模式适配 */


.elder-mode .card-bottom {
  flex-wrap: wrap;
}
.elder-mode .btn-action {
  min-height: var(--control-height);
}

.tab-nav-item { font-size: var(--font-caption); }
.order-card { box-shadow: none; }

/* 未登录状态展示 */
.order-unlogin-panel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}

.unlogin-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 64rpx 40rpx;
}

.unlogin-icon-box {
  width: 110rpx;
  height: 110rpx;
  border-radius: 32rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.unlogin-icon-box image {
  width: 56rpx;
  height: 56rpx;
}

.unlogin-title {
  font-size: var(--font-section);
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.unlogin-desc {
  font-size: var(--font-caption);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.unlogin-action-btn {
  width: 100%;
  max-width: 440rpx;
}

.book-button, .btn-action { transition: opacity var(--motion-fast); }
