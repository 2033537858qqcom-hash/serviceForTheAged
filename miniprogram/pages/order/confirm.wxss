.rating-card { text-align: center; padding: 48rpx 30rpx; }
.rating-title { font-size: var(--font-section); font-weight: 600; }
.stars-box { justify-content: center; gap: 12rpx; margin: 30rpx 0 16rpx; }
.star-item { width: 102rpx; min-height: var(--control-height); display: flex; align-items: center; justify-content: center; font-size: 70rpx; color: #dce3d9; }
.star-item.active { color: #ad732e; }
.score-desc { color: var(--text-secondary); font-size: var(--font-caption); }
.comment-input { width: 100%; min-height: 300rpx; padding: 26rpx; background: #f6f8f3; border: 1rpx solid var(--border-color); border-radius: 16rpx; margin-top: 28rpx; font-size: var(--font-body); line-height: 1.8; }
.btn-submit { margin-top: 34rpx; width: 100%; }
