.container {
  padding: 24rpx;
}

.rating-card, .comment-card {
  padding: 32rpx 28rpx;
  text-align: center;
}

.rating-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #262626;
  margin-bottom: 24rpx;
}

.stars-box {
  justify-content: center;
  gap: 20rpx;
  margin: 20rpx 0;
}

.star-item {
  font-size: 68rpx;
  color: #d9d9d9;
}

.star-item.active {
  color: #faad14;
}

.score-desc {
  font-size: 28rpx;
  color: #faad14;
  font-weight: 500;
  margin-top: 10rpx;
}

.comment-input {
  width: 100%;
  height: 200rpx;
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  text-align: left;
  font-size: 28rpx;
}

.btn-submit {
  margin-top: 48rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 34rpx;
  border-radius: 45rpx;
}
